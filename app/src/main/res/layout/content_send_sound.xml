<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="peterson.ttu.edu.backupaids.activities.SendSoundActivity"
    tools:showIn="@layout/activity_send_sound">

    <TextView
        android:id="@+id/sendSoundOurPinTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/our_pin"
        android:textSize="20sp"
        android:textAppearance="@android:style/TextAppearance.DeviceDefault"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sendSoundStartButton"
        app:layout_constraintLeft_toLeftOf="parent" />

    <ImageButton
        android:id="@+id/sendSoundStartButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="false"
        android:background="@android:color/transparent"
        android:onClick="sendSound"
        android:scaleType="fitCenter"
        android:src="@drawable/power_button_blue2"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintTop_toBottomOf="@id/sendSoundOurPinTextView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintVertical_bias="0.6"
        android:contentDescription="@string/start_stop_sending_audio" />

</android.support.constraint.ConstraintLayout>
