<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="peterson.ttu.edu.backupaids.activities.SendSoundActivity"
    tools:showIn="@layout/activity_send_sound">

    <TextView
        android:id="@+id/sendSoundLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Send to:"
        app:layout_constraintTop_toTopOf="@id/sendSoundPeerSpinner"
        app:layout_constraintBottom_toBottomOf="@id/sendSoundPeerSpinner"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <Spinner
        android:id="@+id/sendSoundPeerSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/sendSoundLabel"
        app:layout_constraintRight_toRightOf="parent" />
</android.support.constraint.ConstraintLayout>
