<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/welcome_to_hearing_phone"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                app:layout_constraintBottom_toTopOf="@id/subtitle"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/let_s_get_you_started"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                app:layout_constraintBottom_toTopOf="@id/tabTextView"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <TextView
                android:id="@+id/tabTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/there_are_2_tabs"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                app:layout_constraintBottom_toTopOf="@+id/tabTable"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subtitle" />

            <TableLayout
                android:id="@+id/tabTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                app:layout_constraintBottom_toTopOf="@+id/buttonTextView"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tabTextView">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/listen_colon"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                        android:layout_margin="8dp" />

                    <TextView
                        android:id="@+id/textView6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/listen_to_what_the_phone_hears"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                        android:layout_margin="8dp" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speak_colon"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                        android:layout_margin="8dp" />

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/send_sound_to_another_phone_fm_style"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                        android:layout_weight="1"
                        android:layout_margin="8dp" />
                </TableRow>

            </TableLayout>

            <TextView
                android:id="@+id/buttonTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:text="@string/here_are_the_buttons"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault"
                app:layout_constraintTop_toBottomOf="@id/tabTable"
                app:layout_constraintBottom_toTopOf="@id/buttonTableLayout"
                app:layout_constraintLeft_toLeftOf="parent"/>

            <TableLayout
                android:id="@+id/buttonTableLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonTextView">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/powerButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_margin="8dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_power_button_blue" />

                    <TextView
                        android:id="@+id/powerButtonTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:text="@string/start_stop"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/imageButton2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_margin="8dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_phone_mic_blue"
                        android:contentDescription="@string/microphone_button" />

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:text="@string/switch_between_phone_mic_and_headset_mic"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/imageButton3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_margin="8dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_phone_in_gray"
                        android:contentDescription="@string/phone_to_phone_button" />

                    <TextView
                        android:id="@+id/textView11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:text="@string/listen_for_connections_from_another_phone_either_make_a_new_connection_or_listen_for_an_existing_one"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:id="@+id/imageButton4"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_margin="8dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_equalizer"
                        android:contentDescription="@string/presets_button" />

                    <TextView
                        android:id="@+id/textView12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:text="@string/customize_what_you_hear"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault" />
                </TableRow>
            </TableLayout>

        </android.support.constraint.ConstraintLayout>
    </ScrollView>


</android.support.constraint.ConstraintLayout>